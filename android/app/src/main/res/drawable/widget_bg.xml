<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background — dark Islamic gradient with green accent border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:top="2dp" android:left="2dp">
        <shape>
            <solid android:color="#1A000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Main background -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#0D1F2D"
                android:centerColor="#112233"
                android:endColor="#0A1A28"
                android:centerX="0.5"
                android:centerY="0.5" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#1F4433" />
        </shape>
    </item>
</layer-list>
